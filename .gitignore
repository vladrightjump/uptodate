node_modules
dist
dist-ssr
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
.env
.env.local
*.log
.vercel
.netlify

# TypeScript build cache. tsc -b now emits into node_modules/.tmp
# (see tsconfig.json / tsconfig.node.json), so these are only a safety net.
*.tsbuildinfo

# Kept deliberately: Vite resolves vite.config.js BEFORE vite.config.ts, so a
# stale copy left over from a pre-outDir build would silently shadow the real
# config for everyone if it were ever committed.
vite.config.d.ts
vite.config.js

# local npm cache (workaround for root-owned ~/.npm)
.npm-cache/
.npmrc
coverage/
