# Copy to .env.local for local dev, and set the same two in Vercel
# (Project → Settings → Environment Variables) for the deployed site.
#
# Leave them unset and the app still works — "known" flags and notes are kept
# in localStorage and nothing is sent anywhere. Setting them turns on syncing
# to Supabase, keyed by an anonymous per-browser device id.
#
# The anon key is a publishable key: it ships inside the browser bundle and is
# meant to be public. The tables it can reach are behind RLS with no policies;
# all access goes through the stored procedures in supabase/migrations.
#
# IMPORTANT: change VITE_SUPABASE_URL and you must change the CSP too. The
# deployed site pins this exact host in `connect-src` (vercel.json). Point this
# at another project without editing that, and the browser blocks every request
# before it leaves the page — the only symptom is a permanently amber sync dot.

VITE_SUPABASE_URL=https://fkcuqucxdodrlwesfjji.supabase.co
VITE_SUPABASE_ANON_KEY=
